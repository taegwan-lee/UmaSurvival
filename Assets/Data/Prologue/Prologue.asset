  m_Name: Prologue
  m_EditorClassIdentifier: Assembly-CSharp::StorySequence
  background: {fileID: 3994834507782016903, guid: 4ea8a7b510d1d7140883bec8216be23d, type: 3}
  leftName: "\uB2E4\uC774\uC640 \uC2A4\uCE7C\uB81B"
  leftPortrait: {fileID: -9052212019501276777, guid: 0f8f4d6d81d3f13428b1cc28b9dd300a, type: 3}
  rightName: "\uC544\uADF8\uB124\uC2A4 \uD0C0\uD0A4\uC628"
  rightPortrait: {fileID: 782444304567222087, guid: 2402bdcacb033e243b2ba3ac22b4501b, type: 3}
  lines:
  - speaker: 2
    text: "\uD2B8\uB808\uC13C \uD559\uC6D0\uC758 \uC6B4\uB3D9\uC7A5. \uC624\uB298\uC758
      \uD6C8\uB828\uC774 \uB9C9 \uB05D\uB0AC\uB2E4."
    expression: {fileID: 0}
    audioClip: {fileID: 0}
    exitPortrait: 0
  - speaker: 0
    text: "\uD6C4 \uC624\uB298\uB3C4 \uD2B8\uB808\uC774\uB2DD \uC644\uB8CC! \uC644\uBCBD\uD788
      \uB9C8\uCCE4\uC5B4."
    expression: {fileID: 0}
    audioClip: {fileID: 0}
    exitPortrait: 0
  - speaker: 0
    text: "\uC544\uB2C8 \uC800\uAC8C \uBB50\uC57C!!"
    expression: {fileID: 7189197776161399101, guid: e30ca24b68d1a88439f9d1cc61b2cde6, type: 3}
    audioClip: {fileID: 0}
    exitPortrait: 0
  - speaker: 1
    text: "\uBBF8\uC548\uD558\uB124 \uC2A4\uCE7C\uB81B\uAD70\n\uC2E4\uD5D8\uC774
      \uC2E4\uD328\uD574\uC11C \uB9D0\uC774\uC57C"
    expression: {fileID: 0}
    audioClip: {fileID: 0}
    exitPortrait: 0
  - speaker: 0
    text: "\uC544\uB2C8\uC694!\n\uC800...\uC800\uAC74 \uB3C4\uB300\uCCB4"
    expression: {fileID: 7189197776161399101, guid: e30ca24b68d1a88439f9d1cc61b2cde6, type: 3}
    audioClip: {fileID: 0}
    exitPortrait: 0
  - speaker: 2
    text: 
    expression: {fileID: 0}
    audioClip: {fileID: 0}
    exitPortrait: 0
  - speaker: 0
    text: 
    expression: {fileID: 0}
    audioClip: {fileID: 0}
    exitPortrait: 2
